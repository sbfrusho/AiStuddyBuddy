<?xml version="1.0" encoding="utf-8"?>
<!-- Every AI provider is reached over HTTPS; refuse plain HTTP so keys and questions can't leak. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
