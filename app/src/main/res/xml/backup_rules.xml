<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 11 and lower. Backups are off (allowBackup="false" in the manifest); these excludes are
   a second guard in case backup is ever turned back on. API keys, saved answers and settings stay
   on this device only. The keys are encrypted with an Android Keystore key, which never leaves the
   device, so a restored copy couldn't be decrypted anyway.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
